<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bisita Eskaera</title>

</head>
<body style="font-family: Arial, sans-serif; background-color: #f4f4f4; text-align: center; padding: 20px;">
<div class="container" style="background: white; padding: 20px; border-radius: 8px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); max-width: 500px; margin: auto;">
    <h2>Bisita eskaera berria</h2>
    <p>Bisita berri bat jaso da. Hemen dituzu xehetasunak:</p>
    <p><strong>Nondik:</strong> {{ from }}</p>
    <p><strong>Taldea:</strong> {{ group }}</p>
    <p><strong>Kopurua:</strong> {{ quantity }}</p>
    <p><strong>Data:</strong> {{ date }}</p>
    <div>
        <!-- Botón para llamar a la función Onartu -->
        <a href="{{ onartuUrl }}" class="button accept" style="display: inline-block; padding: 10px 20px; margin: 10px; text-decoration: none; color: white; border-radius: 5px; background-color: #28a745;">Onartu</a>

        <!-- Botón para llamar a la función Ukatu -->
        <a href="{{ ukatuUrl }}" class="button reject" style="display: inline-block; padding: 10px 20px; margin: 10px; text-decoration: none; color: white; border-radius: 5px; background-color: #dc3545;">Ukatu</a>
    </div>
</div>
</body>
</html>
