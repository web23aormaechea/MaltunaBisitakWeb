{% extends 'base.html.twig' %}

{% block title %}Bisita Eskaera{% endblock %}

{% block body %}
    <div class="d-flex w-100">
        <!-- Lado izquierdo -->
        <div class="w-50 p-4">
            <!-- Formulario para enviar los datos -->
            <form id="bisitaForm" action="/" method="POST">
                <h1 class="mb-4">Bisita eskaera</h1>

                <div class="mb-3">
                    <label for="nondik" class="form-label">Nondik:</label>
                    <input type="text" id="nondik" name="nondik" class="form-control">
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="d-flex align-items-center">
                        <input type="checkbox" id="taldea" name="taldea" class="me-2">
                        <label for="taldea" class="me-3">Taldea zarete?</label>
                        <input type="number" id="kopurua" name="kopurua" class="form-control w-50" placeholder="Kopurua" disabled>
                    </div>
                    <div class="d-flex align-items-center">
                        <label for="data" class="form-label me-2">Data:</label>
                        <input type="text" id="data" name="data" class="form-control js-datepicker w-75" placeholder="Selecciona la fecha">
                    </div>
                </div>

                <!-- Tabla de bisitariak -->
                <div class="w-100">
                    <table class="table table-striped table-hover">
                        <thead>
                        <tr>
                            <th>Izena</th>
                            <th>Abizena</th>
                            <th>Emaila</th>
                        </tr>
                        </thead>
                        <tbody id="bisitariakTableBody">
                        <!-- Las filas de la tabla serán añadidas dinámicamente -->
                        </tbody>
                    </table>
                </div>

                <!-- Campo oculto para enviar los visitantes al backend -->
                <input type="hidden" id="bisitariakData" name="bisitariakData">

                <!-- Botón para enviar los datos al servidor -->
                <div class="text-end mt-3">
                    <button type="submit" class="btn btn-success">Bidali eskaera</button>
                </div>
            </form>
        </div>

        <!-- Lado derecho -->
        <div class="w-50 p-4 d-flex flex-column justify-content-start">
            <h2 class="mb-4">Gehitu Bisitaria</h2>
            <div>
                <div class="container">
                    <div class="row">
                        <!-- Columna izquierda: Izena, Emaila -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <input type="text" id="izena" class="form-control" placeholder="Izena">
                            </div>
                            <div class="mb-3">
                                <input type="email" id="emaila" class="form-control" placeholder="Emaila">
                            </div>
                        </div>
                        <!-- Columna derecha: Abizena, Botón -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <input type="text" id="abizena" class="form-control" placeholder="Abizena">
                            </div>
                            <div class="mt-4">
                                <!-- Botón para agregar visitantes -->
                                <button type="button" id="gehituBtn" class="btn btn-primary">Gehitu bisitaria</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        var Euskara = {
            weekdays: {
                shorthand: ['Ig', 'Al', 'Ar', 'Az', 'Og', 'Or', 'La'],
                longhand: ['Igandea', 'Astelehena', 'Asteartea', 'Asteazkena', 'Osteguna', 'Ostirala', 'Larunbata'],
            },
            months: {
                shorthand: ['Urt', 'Ots', 'Mar', 'Api', 'Mai', 'Eka', 'Uzt', 'Abu', 'Ira', 'Urr', 'Aza', 'Abe'],
                longhand: ['Urtarrila', 'Otsaila', 'Martxoa', 'Apirila', 'Maiatza', 'Ekaina', 'Uztaila', 'Abuztua', 'Iraila', 'Urria', 'Azaroa', 'Abendua'],
            },
            firstDayOfWeek: 1,
            ordinal: () => 'a',
            rangeSeparator: ' - ',
            weekAbbreviation: 'Ast',
            scrollTitle: 'Korritu handitzeko',
            toggleTitle: 'Egin klik trukatzeko',
            amPM: ['AM', 'PM'],
            yearAriaLabel: 'Urtea',
            time_24hr: true,
        };
        // Pasamos los datos de PHP a JavaScript
        let dateMap = {{ calendarData|json_encode|raw }};  // Asegúrate de que calendarData esté bien estructurado
        let dateField = document.querySelector('.js-datepicker');

        if (dateField) {
            flatpickr(dateField, {
                minDate: 'today',  // No permitir fechas pasadas
                dateFormat: 'Y-m-d',  // Formato de fecha
                locale: Euskara,  // Configuración del idioma
                disable: [
                    function (date) {
                        // Ajustamos el día de la fecha para coincidir con el formato de la fecha
                        let dateStr = new Date(date);  // Usamos un nuevo objeto Date para asegurarnos de que sea el correcto
                        dateStr.setDate(dateStr.getDate() + 1);  // Sumamos 1 día para ajustar correctamente
                        dateStr = dateStr.toISOString().split('T')[0];  // Convertimos a formato 'Y-m-d'

                        // ❌ Bloqueamos los fines de semana (sábado y domingo)
                        if (date.getDay() === 0 || date.getDay() === 6) {
                            return true; // Deshabilitar fines de semana
                        }

                        // ❌ Bloqueamos los días que no están en la base de datos
                        return !(dateStr in dateMap);
                    }
                ],
                firstDayOfWeek: 1, // Empieza la semana el lunes
                onDayCreate: function (dObj, dStr, fp, dayElem) {
                    let dateObj = dayElem.dateObj; // Obtener el objeto Date
                    let dateStr = new Date(dateObj);  // Crear un nuevo objeto Date para asegurarnos de que esté bien alineado
                    dateStr.setDate(dateStr.getDate() + 1);  // Sumamos 1 día para ajustar correctamente
                    dateStr = dateStr.toISOString().split('T')[0];  // Convertimos a formato 'Y-m-d'
                    let dayOfWeek = dateObj.getDay();  // Día de la semana en 0-6 (domingo a sábado)

                    // 🎨 Aplicamos colores solo si la fecha está en dateMap
                    if (dateMap[dateStr] !== undefined) {
                        if (dateMap[dateStr] === 0) {
                            dayElem.classList.add('day-saved');
                        }
                        else if (dateMap[dateStr] === 1) {
                            dayElem.classList.add('day-warning');
                        }
                        else if (dateMap[dateStr] >= 2) {
                            dayElem.classList.add('day-full');
                            dayElem.classList.add('flatpickr-disabled');
                        }
                    } else {
                        // Si la fecha no está en dateMap, la deshabilitamos y la ponemos en blanco
                        dayElem.classList.add('flatpickr-disabled');  // Deshabilitar el día
                        dayElem.style.backgroundColor = '#fff';  // Poner el fondo en blanco
                        dayElem.style.color = '#ccc';  // Cambiar el color del texto a gris claro
                        dayElem.style.pointerEvents = 'none';  // Desactivar la interacción con el día
                    }

                    // 🟩 Aseguramos que TODOS los fines de semana (sábado y domingo) tengan clase 'weekend'
                    if (dayOfWeek === 6 || dayOfWeek === 0) {
                        dayElem.classList.add('weekend');
                    }
                },
            });
        }







        // Habilitar/deshabilitar el campo "kopurua" según si se marca el checkbox
        document.getElementById('taldea').addEventListener('change', function() {
            document.getElementById('kopurua').disabled = !this.checked;
        });

        // Agregar visitante a la tabla
        document.getElementById('gehituBtn').addEventListener('click', function() {
            let izena = document.getElementById('izena').value;
            let abizena = document.getElementById('abizena').value;
            let emaila = document.getElementById('emaila').value;

            if (izena && abizena && emaila) {
                let tableBody = document.getElementById('bisitariakTableBody');
                let newRow = `<tr><td>${izena}</td><td>${abizena}</td><td>${emaila}</td></tr>`;
                tableBody.innerHTML += newRow;

                // Limpiar los campos después de agregar el visitante
                document.getElementById('izena').value = '';
                document.getElementById('abizena').value = '';
                document.getElementById('emaila').value = '';
            } else {
                alert('Mesedez, bete eremu guztiak.');
            }
        });
        // Manejar el envío del formulario
        document.getElementById('bisitaForm').addEventListener('submit', function(e) {
            e.preventDefault();  // Prevenir el envío normal del formulario

            // Recoger todos los visitantes de la tabla
            let bisitariakData = [];
            let rows = document.querySelectorAll('#bisitariakTableBody tr');
            rows.forEach(function(row) {
                let izena = row.cells[0].textContent;
                let abizena = row.cells[1].textContent;
                let emaila = row.cells[2].textContent;
                bisitariakData.push({ izena: izena, abizena: abizena, emaila: emaila });
            });

            // Recoger los otros datos del formulario
            let nondik = document.getElementById('nondik').value;
            let taldea = document.getElementById('taldea').checked;
            let kopurua = document.getElementById('kopurua').value;
            let data = document.getElementById('data').value;

            // Crear un objeto de formulario con los datos
            let formData = new FormData();
            formData.append('nondik', nondik);
            formData.append('taldea', taldea);
            formData.append('kopurua', kopurua);
            formData.append('data', data);
            formData.append('bisitariakData', JSON.stringify(bisitariakData));

            // Enviar los datos al backend
            fetch('/', {
                method: 'POST',
                body: formData
            })
                .then(response => response.json())
                .then(data => {
                    if (data.redirect) {
                        window.location.href = data.redirect;
                    }
                })
                .catch(error => {
                    console.error('Error al enviar el formulario:', error);
                });
        });


    </script>
    <style>
        /* 🎨 Colores para visitas */
        .day-saved {
            background-color: #4CAF50 !important; /* Verde */
            color: white !important;
        }

        .day-warning {
            background-color: #FFC107 !important; /* Amarillo */
            color: white !important;
        }

        .day-full {
            background-color: #DC3545 !important; /* Rojo */
            color: white !important;
        }

        /* 🔴 Fines de semana */
        .weekend {
            background-color: #f8d7da !important;
            color: red !important;
            opacity: 1 !important;
        }

        /* 🔴 Asegurar que fines de semana deshabilitados mantengan color */
        .flatpickr-day.weekend.flatpickr-disabled {
            background-color: #f8d7da !important;
            color: red !important;
        }
    </style>
{% endblock %}
