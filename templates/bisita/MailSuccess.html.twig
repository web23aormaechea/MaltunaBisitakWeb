{% extends 'base.html.twig' %}

{% block body %}
    <div class="d-flex flex-column justify-content-center align-items-center vh-100 bg-light text-center">
        <div class="card shadow-lg p-5 border-0 rounded-lg" style="max-width: 500px;">
            <div class="card-body">
                <h1 class="text-success fw-bold">Operazioa burutu da arrakastaz!</h1>
                <p class="fs-5 text-muted">Mezuak arrakastaz bidali dira helmugako guztiei.</p>
                <p>Eskerrik asko zure eskaera prozesatzeagatik.</p>
                <div class="mt-4">
                    <!-- Botón que cierra la pestaña del navegador -->
                    <button onclick="window.close();" class="btn btn-primary">Itzuli orrialde nagusira</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}